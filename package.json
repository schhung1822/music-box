{
  "name": "music-lyric",
  "version": "0.1.0",
  "private": true,
  "description": "Khoảng lặng — trình phát nhạc, lời hát đồng bộ và ghi video. Bản chạy trên Windows.",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node tests/run.cjs",
    "desktop": "node desktop/build-web.cjs && node desktop/start.cjs",
    "desktop:start": "node desktop/start.cjs",
    "desktop:dist": "node desktop/make-icon.cjs && node desktop/build-web.cjs && electron-builder --win"
  },
  "dependencies": {
    "next": "16.3.4",
    "ogl": "^1.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "electron": "41.7.1",
    "electron-builder": "26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "rcedit": "4.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "vn.khoanglang.musicrecorder",
    "productName": "Khoảng Lặng",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "desktop-web/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "icon": "build/icon.ico",
    "afterPack": "desktop/after-pack.cjs"
  }
}
